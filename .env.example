# Postgres - Neon (create a free project at neon.tech)
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require&channel_binding=require
READONLY_DATABASE_URL=postgresql://nl2sql_readonly:your-readonly-password@your-project.neon.tech/neondb?sslmode=require&channel_binding=require

# LLM providers - get your own keys
ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_PROVIDER_ORDER=claude,gemini
GEMINI_API_KEY=your-gemini-key-here

# MongoDB - Atlas (create a free M0 cluster at mongodb.com/cloud/atlas)
MONGO_URL=mongodb+srv://user:password@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_READONLY_URL=mongodb+srv://readonly-user:password@your-cluster.mongodb.net/?retryWrites=true&w=majority

# Neo4j - AuraDB (create a free instance at console.neo4j.io)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here