# Postgres
POSTGRES_USER=nl2sql_user
POSTGRES_PASSWORD=nl2sql_pass
POSTGRES_DB=nl2sql_db
READONLY_PASSWORD=readonly_pass

# LLM providers - get your own keys
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
LLM_PROVIDER_ORDER=claude,gemini

# MongoDB Atlas - create your own free cluster at mongodb.com/cloud/atlas
MONGO_URL=mongodb+srv://user:password@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_READONLY_URL=mongodb+srv://readonly-user:password@your-cluster.mongodb.net/?retryWrites=true&w=majority